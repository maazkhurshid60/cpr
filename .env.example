# Public site address, used for canonical links, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://www.drztraining.com

# Form email delivery (resend.com). Without these, forms show the phone number
# and email instead of a thank-you, and the enquiry is written to the server log.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. bookings@drztraining.com
LEAD_FROM_EMAIL=
# Where enquiries land. Defaults to drztraining026@gmail.com.
LEAD_TO_EMAIL=
