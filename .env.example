# Public site address, used for canonical links, the sitemap and social cards.
# On GitHub Pages this comes from the SITE_URL repo variable instead.
NEXT_PUBLIC_SITE_URL=https://www.drztraining.com

# Sub-path the site is served from. Leave empty locally and on a custom domain;
# the deploy workflow sets it to /cpr for username.github.io/cpr.
NEXT_PUBLIC_BASE_PATH=

# Form delivery (web3forms.com). Create a free access key for the inbox that
# should receive enquiries. Without it, forms show the phone number and email
# instead of a thank-you. On GitHub this is the WEB3FORMS_KEY repo variable.
NEXT_PUBLIC_WEB3FORMS_KEY=
